<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agent.dao.KnowledgeVersionCleanupMapper">

    <!-- 知识旧版本清理任务结果映射 -->
    <resultMap id="knowledgeVersionCleanupResultMap" type="com.agent.entity.KnowledgeVersionCleanup">
        <id property="id" column="id"/>
        <result property="documentId" column="document_id"/>
        <result property="version" column="version"/>
        <result property="status" column="status" javaType="com.agent.enums.KnowledgeCleanupStatusEnum"/>
        <result property="eligibleAt" column="eligible_at"/>
        <result property="retryCount" column="retry_count"/>
        <result property="nextRetryAt" column="next_retry_at"/>
        <result property="lastError" column="last_error"/>
        <result property="completedAt" column="completed_at"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- 公共查询字段 -->
    <sql id="cleanupColumns">
        id, document_id, version, status, eligible_at, retry_count,
        next_retry_at, last_error, completed_at, created_at, updated_at
    </sql>

    <!-- 只登记任务，不执行向量删除 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO knowledge_version_cleanup (document_id, version, status, eligible_at, retry_count)
        VALUES (#{documentId}, #{version}, 'PENDING', #{eligibleAt}, 0)
    </insert>

    <!-- 根据任务主键查询 -->
    <select id="selectById" resultMap="knowledgeVersionCleanupResultMap">
        SELECT <include refid="cleanupColumns"/>
        FROM knowledge_version_cleanup
        WHERE id = #{id}
    </select>

    <!-- 查看指定文档最近的清理任务 -->
    <select id="selectRecentByDocumentId" resultMap="knowledgeVersionCleanupResultMap">
        SELECT <include refid="cleanupColumns"/>
        FROM knowledge_version_cleanup
        WHERE document_id = #{documentId}
        ORDER BY id DESC
        LIMIT 50
    </select>

</mapper>
